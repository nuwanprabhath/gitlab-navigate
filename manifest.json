{
  "manifest_version": 3,
  "name": "GitLab Navigate",
  "version": "0.13.0",
  "description": "Jump straight to a GitLab ticket, merge request, commit, or branch history from a number, hash, or branch name.",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "gitlab-navigate@nuwanprabhath.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitLab Navigate"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Open GitLab Navigate"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
