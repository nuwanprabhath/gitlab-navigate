{
  "manifest_version": 3,
  "name": "GitLab Navigate",
  "version": "0.7.0",
  "description": "Jump straight to a GitLab ticket, merge request, commit, or branch history from a number, hash, or branch name.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitLab Navigate"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Open GitLab Navigate"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
